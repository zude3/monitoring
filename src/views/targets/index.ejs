<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Targets</title>
</head>
<body>
    <h1>Targets</h1>
    <% if(targets.length > 0) { %>
        <ul>
            <% targets.forEach(target => { %>
                <li>
                    <strong><%= target.name %></strong> - <%= target.description %>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No targets found, add some targets.</p>
    <% } %>
    <a href="/targets/create">Add Target</a>
</body>
</html>