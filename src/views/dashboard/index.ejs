<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <style>
        .monitoring-card {
            border: 1px solid #ddd;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 10px;
        }

        .progress-container {
            width: 100%;
            height: 20px;
            background: #eee;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
        }

        .red {
            background: red;
        }

        .yellow {
            background: orange;
        }

        .green {
            background: green;
        }

        .calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 3px;
        }

        .calendar-header {
            font-weight: bold;
            text-align: center;
            padding: 3px;
        }

        .calendar-day {
            min-height: 60px;
            padding: 8px;
            border-radius: 10px;
            text-decoration: none;
            color: inherit;
        }

        .calendar-day.empty {
            background: transparent;
        }

        .day-number {
            font-weight: bold;
            font-size: 18px;
        }

        .activity-info {
            margin-top: 10px;
            font-size: 14px;
        }

        .legend {
            display: flex;
            gap: 20px;
            margin-top: 20px;
        }

        .calendar-day:hover {
            transform: translateY(-2px);
            cursor: pointer;
        }

        .status-list {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 10px;
        }

        .category-status {
            display: flex;
            gap: 4px;
            margin-top: 8px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        .status-dot.red {
            background: red;
        }

        .status-dot.yellow {
            background: orange;
        }

        .status-dot.green {
            background: green;
        }

    </style>
</head>
<body>
    <h1>Welcome to the Dashboard</h1>

    <h2>Daily Monitoring Calendar</h2>

<form method="GET" action="/dashboard">

    <label>Month</label>

    <select name="month" onchange="this.form.submit()">
        <% for (let i = 1; i <= 12; i++) { %>
            <option
                value="<%= i %>"

                <%= i === month
                    ? "selected"
                    : "" %>
            >
                <%= new Date(
                    2026,
                    i - 1
                ).toLocaleDateString(
                    "id-ID",
                    {
                        month: "long"
                    }
                ) %>
            </option>

        <% } %>
    </select>
    <input
        type="number"
        name="year"
        value="<%= year %>"
        onchange="this.form.submit()"
    >
</form>

<div class="calendar">
        <% [
            "Mon",
            "Tue",
            "Wed",
            "Thu",
            "Fri",
            "Sat",
            "Sun"
        ].forEach(dayName => { %>
            <div class="calendar-header">
                <%= dayName %>
            </div>
        <% }) %>

        <% calendar.forEach(day => { %>
            <% if (!day) { %>
                <div
                    class="calendar-day empty"
                ></div>
            <% } else { %>
                <!-- <pre><%= JSON.stringify(day, null, 2) %></pre> -->
                <a
                    href="/activities/detail?date=<%= day.date %>"
                    class="calendar-day "
                >
                <div class="day-number">
                    <%= day.day %>
                </div>

                <div class="category-status">

                    <% day.daily.forEach(item => { %>

                        <span
                            class="status-dot <%= item.status %>"
                            title="<%= item.category_name %>"
                        ></span>

                    <% }) %>

                </div>
                </a>
            <% } %>
        <% }) %>
    </div>
<br>

    <h2>Today Monitoring</h2>
    <% if (dailyMonitoring.length === 0) { %>
        <p>Belum ada target harian.</p>
    <% } %>

    <% dailyMonitoring.forEach(item => { %>
        <div class="monitoring-card">
            <h3>
                <%= item.name %>
                <% if (item.status === "red") { %>
                    🔴
                <% } %>

                <% if (item.status === "yellow") { %>
                    🟡
                <% } %>

                <% if (item.status === "green") { %>
                    🟢
                <% } %>
            </h3>

            <a href="/activities/create">Add Activity</a><br>

            <p>
                <strong>
                    <%= item.actual_value %>
                </strong>
                /
                <strong>
                    <%= item.target_value %>
                </strong>
                minutes
            </p>

            <div class="progress-container">
                <div
                    class="progress-bar <%= item.status %>"
                    style="width: <%= Math.min(Number(item.progress_percentage), 100) %>%"
                ></div>
            </div>

            <p><%= item.progress_percentage %>%</p>
        </div>
    <% }) %>
    <hr>

    <a href="/activities/create">Add Activity</a><br>
    <a href="/targets">Targets</a><br>
    <a href="/categories">Manage Categories</a><br>
    <a href="/activities">Manage Activities</a><br>
    <a href="/auth/logout">Logout</a><br>
</body>
</html>