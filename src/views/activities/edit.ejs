<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Activity</title>
</head>
<body>
    <h1>Edit Activity</h1>
    <form action="/activities/<%= activity.id %>/edit" method="POST">
        <label for="category_id">Category:</label>
        <select id="category_id" name="category_id" required>
            <% categories.forEach(category => { %>
                <option value="<%= category.id %>" <%= category.id === activity.category_id ? 'selected' : '' %>><%= category.name %></option>
            <% }); %>
        </select>
        <br>
        <label for="name">Name:</label>
        <input type="text" id="name" name="name" value="<%= activity.name %>" required>
        <br>
        <label for="duration">Duration (in minutes):</label>
        <input type="number" id="duration" name="duration" value="<%= activity.duration %>" required>
        <br>
        <label for="activity_date">Date:</label>
        <input type="date" id="activity_date" name="activity_date" value="<%= activity.activity_date.toISOString().split('T')[0] %>" required>
        <br>
        <label for="activity_time">Time:</label>
        <input type="time" id="activity_time" name="activity_time" value="<%= activity.activity_time %>" required>
        <br>
        <label for="notes">Notes:</label>
        <textarea id="notes" name="notes"><%= activity.notes %></textarea>
        <br>
        <button type="submit">Update Activity</button>
    </form>
    <a href="/activities">cancel</a>
</body>
</html>